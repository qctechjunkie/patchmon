# Database Configuration
POSTGRES_DB=patchmon_db
POSTGRES_USER=patchmon_user
# Generate with: openssl rand -hex 64
POSTGRES_PASSWORD=your-postgres-password-here

# Redis Configuration
# Generate with: openssl rand -hex 64
REDIS_PASSWORD=your-redis-password-here
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Backend Configuration
# Generate with: openssl rand -hex 64
JWT_SECRET=your-jwt-secret-here
LOG_LEVEL=info

# Server Configuration
# Protocol used by agents to connect (http or https)
SERVER_PROTOCOL=http
# Your server's IP address or domain name
SERVER_HOST=your-server-ip-or-domain
# Port where the frontend will be accessible
SERVER_PORT=3001
# Frontend URL for CORS (include protocol, e.g., https://patchmon.example.com)
CORS_ORIGIN=http://localhost:3001

# Database Connection Pool Configuration (Prisma)
# Reduced for Raspberry Pi 5 (20 is optimal for 4GB, can increase to 30 for 8GB model)
DB_CONNECTION_LIMIT=20
DB_POOL_TIMEOUT=20
DB_CONNECT_TIMEOUT=10
DB_IDLE_TIMEOUT=300
DB_MAX_LIFETIME=1800

# Rate Limiting (times in milliseconds)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=500
AGENT_RATE_LIMIT_WINDOW_MS=60000
AGENT_RATE_LIMIT_MAX=1000

# Resource Limits
# Default values are optimized for Raspberry Pi 5 (4-8GB RAM)
# For more powerful systems, you can increase these limits:
#   - Raspberry Pi 5 (4GB): Use defaults below
#   - Raspberry Pi 5 (8GB): Can increase by 50%
#   - x86_64 servers: Can double or triple these values
BACKEND_MEMORY_LIMIT=384m
BACKEND_MEMORY_RESERVATION=192m
FRONTEND_MEMORY_LIMIT=192m
FRONTEND_MEMORY_RESERVATION=96m
POSTGRES_MEMORY_LIMIT=384m
POSTGRES_MEMORY_RESERVATION=192m
REDIS_MEMORY_LIMIT=128m
REDIS_MEMORY_RESERVATION=64m
