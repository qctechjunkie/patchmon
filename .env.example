# PatchMon Environment Configuration - Example Template
# Copy this file to .env and update with your actual values
# Generate secure passwords using: openssl rand -hex 64

# Database Configuration
POSTGRES_DB=patchmon_db
POSTGRES_USER=patchmon_user
POSTGRES_PASSWORD=your-secure-postgres-password-here

# Redis Configuration
REDIS_PASSWORD=your-secure-redis-password-here

# Backend/JWT Configuration
JWT_SECRET=your-secure-jwt-secret-here

# Server Configuration
# SERVER_PROTOCOL: Protocol used by agents to connect (http or https)
SERVER_PROTOCOL=http
# SERVER_HOST: Your server's IP address or domain name (what agents will use to connect)
SERVER_HOST=192.168.1.100
# SERVER_PORT: Port where the frontend will be accessible
SERVER_PORT=3001
# CORS_ORIGIN: Full URL where you'll access the frontend (e.g., https://patchmon.example.com)
CORS_ORIGIN=http://192.168.1.100:3001

# Logging
LOG_LEVEL=info

# Database Connection Pool Configuration (Prisma)
DB_CONNECTION_LIMIT=30
DB_POOL_TIMEOUT=20
DB_CONNECT_TIMEOUT=10
DB_IDLE_TIMEOUT=300
DB_MAX_LIFETIME=1800

# Rate Limiting (times in milliseconds)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=500
AGENT_RATE_LIMIT_WINDOW_MS=60000
AGENT_RATE_LIMIT_MAX=1000

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
